
@startuml

title Account-to-Account Transfer

actor Customer
participant TransferController
participant TransferService
participant AccountService
participant TransactionService
database AccountRepository
database TransferRepository
database TransactionRepository

Customer -> TransferController : POST /api/transfers
TransferController -> TransferService : createTransferBetweenAccounts(request)

activate TransferService

note over TransferService
    @Transactional
    All database changes are atomic.
end note

TransferService -> AccountService : getAccount(fromAccountId)
AccountService -> AccountRepository : findById(fromAccountId)
AccountRepository --> AccountService : fromAccount
AccountService --> TransferService : fromAccount

TransferService -> AccountService : getAccount(toAccountId)
AccountService -> AccountRepository : findById(toAccountId)
AccountRepository --> AccountService : toAccount
AccountService --> TransferService : toAccount

TransferService -> TransferService : Check for self-transfer

alt Same account
    TransferService --> TransferController : SameAccountTransferException
    TransferController --> Customer : Error response
else Different accounts

    TransferService -> AccountService : checkAccountStatus(fromAccount)
    TransferService -> AccountService : checkAccountStatus(toAccount)

    TransferService -> TransferService : checkBalance()
    TransferService -> TransferService : checkCurrencies()

    note over TransferService
        Invalid status, insufficient balance
        or currency mismatch aborts the transfer.
    end note

    TransferService -> TransferRepository : saveAndFlush(transfer)
    TransferRepository --> TransferService : TransferEntity (CREATED)

    TransferService -> AccountService : updateBalance(fromAccount, amount, TRANSFER_OUT)
    AccountService -> AccountRepository : saveAndFlush(fromAccount)
    AccountRepository --> AccountService : Updated fromAccount

    TransferService -> AccountService : updateBalance(toAccount, amount, TRANSFER_IN)
    AccountService -> AccountRepository : saveAndFlush(toAccount)
    AccountRepository --> AccountService : Updated toAccount

    TransferService -> TransactionService : createTransferTransaction(fromAccount, reference, transfer, TRANSFER_OUT)
    TransactionService -> TransactionRepository : saveAndFlush(outgoingTransaction)
    TransactionRepository --> TransactionService : TransactionEntity
    TransactionService --> TransferService : outgoingTransaction

    TransferService -> TransactionService : createTransferTransaction(toAccount, reference, transfer, TRANSFER_IN)
    TransactionService -> TransactionRepository : saveAndFlush(incomingTransaction)
    TransactionRepository --> TransactionService : TransactionEntity
    TransactionService --> TransferService : incomingTransaction

    TransferService -> TransferService : setStatus(COMPLETED)
    TransferService -> TransferService : buildTransferResponse()

    TransferService --> TransferController : TransferResponse
    TransferController --> Customer : 200 OK

end

deactivate TransferService

note over AccountRepository, TransactionRepository
    AccountEntity uses @Version for optimistic locking.

    Concurrent update conflicts or other runtime
    failures cause the transaction to roll back.
end note

@enduml
