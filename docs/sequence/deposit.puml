
@startuml

actor Staff
participant StaffController
participant TransactionService
participant AccountService
database AccountRepository
database TransactionRepository

Staff -> StaffController : POST /api/staff/accounts/deposits
StaffController -> TransactionService : deposit(request)

activate TransactionService

TransactionService -> AccountService : getAccount(accountId)
AccountService -> AccountRepository : findById(accountId)
AccountRepository --> AccountService : AccountEntity
AccountService --> TransactionService : AccountEntity

TransactionService -> AccountService : checkAccountStatus(account)
AccountService --> TransactionService : Account is ACTIVE

TransactionService -> AccountService : updateBalance(account, amount, DEPOSIT)
AccountService -> AccountRepository : saveAndFlush(account)
AccountRepository --> AccountService : Updated account

TransactionService -> TransactionService : Create TransactionEntity
note right
    type = DEPOSIT
    amount = request.amount
    balanceAfter = account.balance
end note

TransactionService -> TransactionRepository : saveAndFlush(transaction)
TransactionRepository --> TransactionService : TransactionEntity

TransactionService -> TransactionService : buildResponse(transaction)
TransactionService --> StaffController : TransactionResponse

deactivate TransactionService

StaffController --> Staff : 200 OK

note over TransactionService, TransactionRepository
    @Transactional
    Account balance update and ledger entry
    are committed together or rolled back.
end note

@enduml
