
@startchen

entity USERS {
    id <<key>>
    email <<unique>>
    password_hash
    role
    created_at
}

entity USER_PROFILE {
    id <<key>>
    user_id <<FK>>
    name
    surname
    street
    house_number
    city
    zip_code
    country
    status
    created_at
    updated_at
}

entity ACCOUNT {
    id <<key>>
    account_number <<unique>>
    user_id <<FK>>
    balance
    currency
    status
    version
    created_at
}

entity TRANSFERS {
    id <<key>>
    from_account_id <<FK>>
    to_account_id <<FK>>
    amount
    currency
    status
    created_at
}

entity TRANSACTION {
    id <<key>>
    account_id <<FK>>
    transfer_id <<FK>>
    type
    amount
    balance_after
    reference
    created_at
}

relationship HAS_PROFILE {
}

relationship OWNS {
}

relationship FROM_ACCOUNT {
}

relationship TO_ACCOUNT {
}

relationship HAS_TRANSACTION {
}

relationship RELATED_TRANSFER {
}

HAS_PROFILE -(1,1)- USER_PROFILE
HAS_PROFILE -(0,1)- USERS

OWNS -(0,N)- USERS
OWNS -(1,1)- ACCOUNT

FROM_ACCOUNT -(1,1)- TRANSFERS
FROM_ACCOUNT -(0,N)- ACCOUNT

TO_ACCOUNT -(1,1)- TRANSFERS
TO_ACCOUNT -(0,N)- ACCOUNT

HAS_TRANSACTION -(1,1)- TRANSACTION
HAS_TRANSACTION -(0,N)- ACCOUNT

RELATED_TRANSFER -(0,1)- TRANSACTION
RELATED_TRANSFER -(0,N)- TRANSFERS

@endchen
