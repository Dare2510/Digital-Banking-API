@startuml

class AccountEntity {
    Long id
    String accountNumber
    BigDecimal balance
    Currency currency
    AccountStatus status
    Long version
    LocalDateTime createdAt
}

class UserEntity {
    Long id
    String email
    String passwordHash
    UserRole role
    LocalDateTime createdAt
}

class UserProfileEntity {
    Long id
    String name
    String surname
    String street
    String houseNumber
    String city
    String zipCode
    String country
    ProfileStatus status
    LocalDateTime createdAt
    LocalDateTime updatedAt
}

class TransferEntity {
    Long id
    BigDecimal amount
    Currency currency
    TransferStatus status
    LocalDateTime createdAt
}

class TransactionEntity {
    Long id
    TransactionType type
    BigDecimal amount
    BigDecimal balanceAfter
    String reference
    LocalDateTime createdAt
}

enum Currency {
    EUR
    USD
    GBP
}

enum AccountStatus {
    ACTIVE
    BLOCKED
    CLOSED
}

enum TransferStatus {
    CREATED
    COMPLETED
}

enum TransactionType {
    DEPOSIT
    WITHDRAWAL
    TRANSFER_IN
    TRANSFER_OUT
}

enum UserRole {
    CUSTOMER
    STAFF
    ADMIN
}

enum ProfileStatus {
    INCOMPLETE
    COMPLETE
}

UserEntity "1" --> "0..1" UserProfileEntity : profile
UserEntity "1" --> "0..*" AccountEntity : owns

TransferEntity "0..*" --> "1" AccountEntity : fromAccount
TransferEntity "0..*" --> "1" AccountEntity : toAccount

TransactionEntity "0..*" --> "1" AccountEntity : account
TransactionEntity "0..*" --> "0..1" TransferEntity : transfer

@enduml
